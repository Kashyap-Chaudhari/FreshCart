generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
  CUSTOMER
  DELIVERY_PERSON
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCEL_REQUESTED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  COLLECTED
  FAILED
  REFUNDED
}

enum StockMovementType {
  PURCHASE
  SALE_DEDUCTION
  ORDER_CANCEL_RESTORE
  DAMAGE
  MANUAL_ADJUSTMENT
  RETURN
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model User {
  id                 String                @id @default(uuid())
  name               String
  email              String?               @unique
  phone              String?               @unique
  passwordHash       String?
  role               Role                  @default(CUSTOMER)
  vehicleNumber      String?
  vehicleType        String?
  isActive           Boolean               @default(true)
  isBlocked          Boolean               @default(false)
  isPhoneVerified    Boolean               @default(false)
  addresses          Address[]
  orders             Order[]               @relation("CustomerOrders")
  assignedDeliveries Order[]               @relation("DeliveryPersonOrders")
  auditLogs          AuditLog[]
  stockMovements     StockMovementLedger[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([role])
  @@index([phone])
  @@index([email])
  @@index([isBlocked])
  @@map("users")
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String   @default("Home")
  street       String
  landmark     String?
  city         String
  state        String
  pincode      String
  contactName  String
  contactPhone String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([pincode])
  @@map("addresses")
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  imageUrl     String?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
  @@map("categories")
}

model Product {
  id                String                @id @default(uuid())
  name              String
  slug              String                @unique
  sku               String                @unique
  description       String?
  unit              String // e.g. "1 kg", "500 g", "1 pc", "1 L"
  price             Decimal               @db.Decimal(10, 2)
  mrp               Decimal               @db.Decimal(10, 2)
  costPrice         Decimal?              @db.Decimal(10, 2)
  taxPercent        Decimal               @default(0) @db.Decimal(5, 2)
  stockQty          Int                   @default(0)
  lowStockThreshold Int                   @default(10)
  isAvailable       Boolean               @default(true)
  images            String[]              @default([])
  categoryId        String
  category          Category              @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  stockMovements    StockMovementLedger[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([isAvailable])
  @@index([stockQty])
  @@map("products")
}

model StockMovementLedger {
  id              String            @id @default(uuid())
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  type            StockMovementType
  quantityChange  Int // Negative for deduction, Positive for addition
  balanceAfter    Int
  referenceType   String? // "ORDER", "MANUAL", "CSV_IMPORT"
  referenceId     String? // e.g., orderId
  reason          String
  createdByUserId String?
  createdByUser   User?             @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
  @@map("stock_movement_ledger")
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  validFrom     DateTime
  validTo       DateTime
  usageLimit    Int?
  timesUsed     Int          @default(0)
  isActive      Boolean      @default(true)
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model DeliveryArea {
  id                     String   @id @default(uuid())
  pincode                String   @unique
  areaName               String
  city                   String
  state                  String
  minOrderValue          Decimal  @default(199) @db.Decimal(10, 2)
  deliveryCharge         Decimal  @default(40) @db.Decimal(10, 2)
  freeDeliveryAbove      Decimal? @db.Decimal(10, 2)
  isDeliverable          Boolean  @default(true)
  estimatedDeliveryHours Int      @default(2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([pincode])
  @@index([isDeliverable])
  @@map("delivery_areas")
}

model StoreSetting {
  id                    String   @id @default("default")
  storeName             String   @default("FreshCart Supermarket")
  tagLine               String?  @default("Your Daily Fresh Grocery Partner")
  logoUrl               String?
  phone                 String   @default("+91 98765 43210")
  email                 String   @default("support@freshcart.com")
  address               String   @default("123 Market Road, Koramangala, Bengaluru, Karnataka 560034")
  mapUrl                String?
  openingHours          String   @default("Mon - Sun: 7:00 AM - 10:00 PM")
  gstin                 String   @default("29AAAAA0000A1Z5")
  fssai                 String?  @default("11223344556677")
  invoicePrefix         String   @default("INV-")
  invoiceNextNumber     Int      @default(1001)
  invoiceFooterText     String?  @default("Thank you for shopping with FreshCart! Items once sold can be returned within 24 hours if perishable, or 7 days for packaged goods.")
  minOrderValue         Decimal  @default(199) @db.Decimal(10, 2)
  defaultDeliveryCharge Decimal  @default(40) @db.Decimal(10, 2)
  banners               Json? // Array of banner objects
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("store_settings")
}

model Order {
  id                      String               @id @default(uuid())
  orderNumber             String               @unique // e.g. ORD-20261028-1001
  invoiceNumber           String               @unique // e.g. INV-001001
  userId                  String?
  user                    User?                @relation("CustomerOrders", fields: [userId], references: [id])
  deliveryPersonId        String?
  deliveryPerson          User?                @relation("DeliveryPersonOrders", fields: [deliveryPersonId], references: [id])
  deliveryPersonName      String?
  deliveryStatus          String?              @default("UNASSIGNED") // "UNASSIGNED", "ASSIGNED", "ACCEPTED", "PICKED_UP", "OUT_FOR_DELIVERY", "DELIVERED", "FAILED"
  assignedAt              DateTime?
  acceptedAt              DateTime?
  pickedUpAt              DateTime?
  outForDeliveryAt        DateTime?
  deliveredAt             DateTime?
  deliveryLocation        Json?                // { latitude, longitude, accuracy, timestamp }
  deliveryNotes           String?
  failureReason           String?
  isGuest                 Boolean              @default(false)
  customerName            String
  customerPhone           String
  customerEmail           String?
  shippingAddressSnapshot Json // Stored snapshot so later address edits never change past orders
  status                  OrderStatus          @default(PLACED)
  paymentMethod           String               @default("COD") // Extensible: "COD", "UPI", "CARD"
  paymentStatus           PaymentStatus        @default(PENDING)
  deliveryType            String               @default("DELIVERY") // "DELIVERY" or "PICKUP"
  deliverySlot            String?
  estimatedDeliveryDate   DateTime?
  trackingNumber          String?
  carrier                 String?
  trackingNotes           String?
  cancellationStatus      String?              @default("NONE") // "NONE", "REQUESTED", "APPROVED", "REJECTED"
  pincode                 String
  subtotal                Decimal              @db.Decimal(10, 2)
  taxTotal                Decimal              @db.Decimal(10, 2)
  discountTotal           Decimal              @default(0) @db.Decimal(10, 2)
  deliveryCharge          Decimal              @default(0) @db.Decimal(10, 2)
  grandTotal              Decimal              @db.Decimal(10, 2)
  couponId                String?
  coupon                  Coupon?              @relation(fields: [couponId], references: [id])
  couponCodeSnapshot      String?
  cancellationReason      String?
  cancelledAt             DateTime?
  cancelledByUserId       String?
  isWalkIn                Boolean              @default(false)
  codCollectedAt          DateTime?
  notes                   String?
  items                   OrderItem[]
  statusHistory           OrderStatusHistory[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([orderNumber])
  @@index([invoiceNumber])
  @@index([userId])
  @@index([deliveryPersonId])
  @@index([deliveryStatus])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([pincode])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  productName      String // Snapshot
  productSku       String // Snapshot
  unit             String // Snapshot
  unitPrice        Decimal  @db.Decimal(10, 2) // Price snapshot
  mrp              Decimal  @db.Decimal(10, 2) // MRP snapshot
  taxPercent       Decimal  @db.Decimal(5, 2) // Tax % snapshot
  taxAmount        Decimal  @db.Decimal(10, 2)
  quantity         Int
  lineTotal        Decimal  @db.Decimal(10, 2)
  isSubstituted    Boolean  @default(false)
  substitutionNote String?
  createdAt        DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  note            String?
  changedByUserId String?
  createdAt       DateTime     @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  otpHash   String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
  @@index([isUsed])
  @@map("otp_verifications")
}

