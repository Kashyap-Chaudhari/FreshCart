# ==========================================
# FreshCart Supermarket - Full Stack Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freshcart?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=freshcart

# Application Server (Backend Port 5000)
NODE_ENV=production
PORT=5000
JWT_SECRET=supersecret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (Comma-separated for multi-website setup)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Store Metadata & Statutory Defaults
STORE_NAME="FreshCart Supermarket"
GSTIN="29AAAAA0000A1Z5"
FSSAI="11223344556677"
SUPPORT_PHONE="+91 98765 43210"
SUPPORT_EMAIL="support@freshcart.com"
DEFAULT_INVOICE_PREFIX="INV-"

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
